{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/octm/rsim_001.schema.json",
  "title": "RSIM-001 smoke run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture_id", "assumption_dominance_warnings", "battery_energy_charged_J",
    "battery_energy_discharged_J", "battery_energy_throughput_J", "campaign_id",
    "compute_energy_denied_J", "compute_energy_denied_fraction",
    "delta_peak_temperature_vs_reference_K", "dt_s",
    "electrical_energy_balance_residual_J", "electrical_energy_balance_tolerance_J",
    "electrical_energy_curtailed_J", "electrical_unserved_energy_J", "environment_id",
    "environment_orbits_elapsed", "environment_period_s", "executed_compute_energy_J",
    "executed_mean_compute_power_W", "executed_workload_trace_sha256", "fdir_controller",
    "fdir_latency_s", "final_battery_SOC", "git_commit",
    "hot_phase_executed_energy_fraction", "hot_phase_requested_energy_fraction",
    "initial_battery_SOC", "invalid_reason", "invariants", "maximum_battery_SOC",
    "maximum_absolute_cumulative_electrical_residual_J", "measurement_end_s_exclusive",
    "measurement_start_s", "measurement_window_basis", "minimum_battery_SOC", "mode",
    "model_version", "peak_executed_compute_power_W", "peak_node_temperature_K",
    "peak_radiator_temperature_K", "peak_requested_compute_power_W",
    "physical_realization_sha256", "record_type", "requested_compute_energy_J",
    "requested_mean_compute_power_W", "requested_workload_trace_sha256", "schema_version",
    "scientific_scope", "seed", "simulation_duration_s", "solar_energy_generated_J",
    "thermal_energy_balance_residual_J", "thermal_throttle_event_count",
    "time_above_project_throttle_threshold_s", "time_thermally_throttled_s", "valid_run",
    "workload_allowed_inputs", "workload_id", "workload_label"
  ],
  "properties": {
    "architecture_id": {"type": "string"},
    "assumption_dominance_warnings": {"type": "array", "items": {"type": "string"}},
    "battery_energy_charged_J": {"type": ["number", "null"]},
    "battery_energy_discharged_J": {"type": ["number", "null"]},
    "battery_energy_throughput_J": {"type": ["number", "null"]},
    "campaign_id": {"const": "RSIM-001-smoke"},
    "compute_energy_denied_J": {"type": "number"},
    "compute_energy_denied_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "delta_peak_temperature_vs_reference_K": {"type": "number"},
    "dt_s": {"const": 1.0},
    "electrical_energy_balance_residual_J": {"type": ["number", "null"]},
    "electrical_energy_balance_tolerance_J": {"type": ["number", "null"]},
    "electrical_energy_curtailed_J": {"type": ["number", "null"]},
    "electrical_unserved_energy_J": {"type": ["number", "null"]},
    "environment_id": {"enum": ["E0_CANONICAL", "E1_REPRESENTATIVE_ANALYTIC_LEO"]},
    "environment_orbits_elapsed": {"type": "number"},
    "environment_period_s": {"type": "number"},
    "executed_compute_energy_J": {"type": "number"},
    "executed_mean_compute_power_W": {"type": "number"},
    "executed_workload_trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fdir_controller": {"type": ["string", "null"]},
    "fdir_latency_s": {"type": ["number", "null"]},
    "final_battery_SOC": {"type": ["number", "null"]},
    "git_commit": {"type": ["string", "null"]},
    "hot_phase_executed_energy_fraction": {"type": ["number", "null"]},
    "hot_phase_requested_energy_fraction": {"type": ["number", "null"]},
    "initial_battery_SOC": {"type": ["number", "null"]},
    "invalid_reason": {"type": ["string", "null"]},
    "invariants": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "maximum_battery_SOC": {"type": ["number", "null"]},
    "maximum_absolute_cumulative_electrical_residual_J": {"type": ["number", "null"]},
    "measurement_end_s_exclusive": {"const": 43200.0},
    "measurement_start_s": {"const": 10800.0},
    "measurement_window_basis": {"const": "canonical_wrb_wall_clock"},
    "minimum_battery_SOC": {"type": ["number", "null"]},
    "mode": {"enum": ["THERMAL_ONLY", "POWER_CONSTRAINED", "CLOSED_LOOP"]},
    "model_version": {"type": "string"},
    "peak_executed_compute_power_W": {"type": "number"},
    "peak_node_temperature_K": {"type": "number"},
    "peak_radiator_temperature_K": {"type": "number"},
    "peak_requested_compute_power_W": {"type": "number"},
    "physical_realization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_type": {"const": "run"},
    "requested_compute_energy_J": {"type": "number"},
    "requested_mean_compute_power_W": {"type": "number"},
    "requested_workload_trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "rsim-001-smoke.1"},
    "scientific_scope": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9},
    "simulation_duration_s": {"const": 43200.0},
    "solar_energy_generated_J": {"type": ["number", "null"]},
    "thermal_energy_balance_residual_J": {"type": "number"},
    "thermal_throttle_event_count": {"type": "integer", "minimum": 0},
    "time_above_project_throttle_threshold_s": {"type": "number", "minimum": 0.0},
    "time_thermally_throttled_s": {"type": "number", "minimum": 0.0},
    "valid_run": {"type": "boolean"},
    "workload_allowed_inputs": {"type": "array", "items": {"type": "string"}},
    "workload_id": {"type": "string"},
    "workload_label": {"type": "string"}
  }
}
